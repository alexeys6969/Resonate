<Window x:Class="Resonate.Windows.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Формирование отчёта" SizeToContent="Height" Height="auto" Width="560"
        Background="#1a1a1a" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">

    <Window.Resources>
        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#8EED45"/>
            <Setter Property="FontFamily" Value="\Fonts\Inter-VariableFont_opsz,wght.ttf"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="\Fonts\Inter-VariableFont_opsz,wght.ttf"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>

                                    <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                                  Margin="14,0,0,0"
                                                                  HorizontalContentAlignment="Left"/>

                                    <Border x:Name="ButtonDivider"
                                            Grid.Column="1"
                                            BorderBrush="#3a3a3a"
                                            BorderThickness="1,0,0,0">
                                        <Button x:Name="PART_Button"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Focusable="False">
                                            <TextBlock Text="▾"
                                                       FontSize="16"
                                                       Foreground="#d7d7d7"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,6,0,0"
                                        Padding="8"
                                        Background="#252525"
                                        BorderBrush="#3a3a3a"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Effect="{StaticResource CardShadow}">
                                    <Calendar x:Name="PART_Calendar"
                                              Background="#252525"
                                              BorderThickness="0"
                                              Foreground="White"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#8EED45"/>
                            </Trigger>
                            <Trigger SourceName="PART_Button" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonDivider" Property="Background" Value="#313131"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#252525"
            CornerRadius="20"
            BorderBrush="#3a3a3a"
            BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="📊" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Resonate"
                           FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8EED45" Offset="0"/>
                            <GradientStop Color="#24E3ED" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#2a2a2a"
                    BorderBrush="#3a3a3a"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Отчёт по продажам"
                               FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Выберите период, после чего приложение сформирует документ Word в деловом формате."
                               FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                               FontSize="12"
                               Foreground="#a7a7a7"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Border Height="1"
                            Background="#3a3a3a"
                            Margin="0,18,0,18"/>

                    <TextBlock Text="Период отчёта"
                               FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#d7d7d7"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Дата начала"
                                       FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                                       FontSize="12"
                                       Foreground="#979797"
                                       Margin="2,0,0,8"/>
                            <DatePicker x:Name="StartDatePicker"
                                        Style="{StaticResource ReportDatePickerStyle}"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="—"
                                   Foreground="#6f6f6f"
                                   FontSize="18"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,11"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата окончания"
                                       FontFamily="\Fonts\Inter-VariableFont_opsz,wght.ttf"
                                       FontSize="12"
                                       Foreground="#979797"
                                       Margin="2,0,0,8"/>
                            <DatePicker x:Name="EndDatePicker"
                                        Style="{StaticResource ReportDatePickerStyle}"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="GenerateButton"
                        Click="GenerateReport"
                        Content="📄 Сформировать"
                        Style="{StaticResource DialogButton}"
                        Width="170"
                        Height="45"
                        Margin="0,0,15,0"/>

                <Button x:Name="CancelButton"
                        Click="CancelReport"
                        Content="Отмена"
                        Style="{StaticResource DialogButtonSecondary}"
                        Width="120"
                        Height="45"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
